[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1

[libraries]
linux.debug.x86_64 = "res://./target/debug/lib_godot_rust.so"
linux.release.x86_64 = "res://./target/release/lib_godot_rust.so"
windows.debug.x86_64 = "res://./target/debug/godot_rust.dll"
windows.release.x86_64 = "res://./target/release/godot_rust.dll"
macos.debug = "res://./target/debug/lib_godot_rust.dylib"
macos.release = "res://./target/release/lib_godot_rust.dylib"
macos.debug.arm64 = "res://./target/debug/lib_godot_rust.dylib"
macos.release.arm64 = "res://./target/release/lib_godot_rust.dylib"
