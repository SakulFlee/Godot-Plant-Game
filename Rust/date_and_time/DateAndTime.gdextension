[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1

[libraries]
linux.debug.x86_64 = "res://./target/debug/lib_date_and_time.so"
linux.release.x86_64 = "res://./target/release/lib_date_and_time.so"
windows.debug.x86_64 = "res://./target/debug/date_and_time.dll"
windows.release.x86_64 = "res://./target/release/date_and_time.dll"
macos.debug = "res://./target/debug/lib_date_and_time.dylib"
macos.release = "res://./target/release/lib_date_and_time.dylib"
macos.debug.arm64 = "res://./target/debug/lib_date_and_time.dylib"
macos.release.arm64 = "res://./target/release/lib_date_and_time.dylib"
