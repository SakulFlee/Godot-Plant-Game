[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1

[libraries]
linux.debug.x86_64 = "res://./target/debug/lib_player2d.so"
linux.release.x86_64 = "res://./target/release/lib_player2d.so"
windows.debug.x86_64 = "res://./target/debug/player2d.dll"
windows.release.x86_64 = "res://./target/release/player2d.dll"
macos.debug = "res://./target/debug/lib_player2d.dylib"
macos.release = "res://./target/release/lib_player2d.dylib"
macos.debug.arm64 = "res://./target/debug/lib_player2d.dylib"
macos.release.arm64 = "res://./target/release/lib_player2d.dylib"
