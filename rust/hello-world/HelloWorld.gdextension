[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1

[libraries]
linux.debug.x86_64 = "res://./target/debug/lib_hello_world.so"
linux.release.x86_64 = "res://./target/release/lib_hello_world.so"
windows.debug.x86_64 = "res://./target/debug/hello_world.dll"
windows.release.x86_64 = "res://./target/release/hello_world.dll"
macos.debug = "res://./target/debug/lib_hello_world.dylib"
macos.release = "res://./target/release/lib_hello_world.dylib"
macos.debug.arm64 = "res://./target/debug/lib_hello_world.dylib"
macos.release.arm64 = "res://./target/release/lib_hello_world.dylib"
