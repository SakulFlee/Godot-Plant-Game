[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1

[libraries]
linux.debug.x86_64 = "res://./target/debug/lib_grid_test.so"
linux.release.x86_64 = "res://./target/release/lib_grid_test.so"
windows.debug.x86_64 = "res://./target/debug/grid_test.dll"
windows.release.x86_64 = "res://./target/release/grid_test.dll"
macos.debug = "res://./target/debug/lib_grid_test.dylib"
macos.release = "res://./target/release/lib_grid_test.dylib"
macos.debug.arm64 = "res://./target/debug/lib_grid_test.dylib"
macos.release.arm64 = "res://./target/release/lib_grid_test.dylib"
